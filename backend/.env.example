# NexusAI Environment Configuration
# Copy this to .env and fill in your values

# ─── LM Studio / Local LLM ──────────────────────────────────────────────────
# LM Studio runs an OpenAI-compatible server at localhost by default
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model   # Set to the model name shown in LM Studio

# ─── ngrok Tunnel (optional — use if connecting remotely) ───────────────────
# Set this if you want to use the ngrok URL instead of localhost
# NGROK_BASE_URL=https://your-ngrok-id.ngrok-free.app/v1

# ─── LLM Provider Mode ──────────────────────────────────────────────────────
# Options: "lmstudio" | "ngrok" | "openai" | "anthropic" | "gemini"
LLM_PROVIDER=lmstudio

# ─── Fallback Cloud API Keys (optional) ─────────────────────────────────────
# Only needed if LLM_PROVIDER is set to a cloud provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── App Settings ────────────────────────────────────────────────────────────
APP_NAME=NexusAI
HOST=127.0.0.1
PORT=8765
DEBUG=true

# ─── Data Paths (auto-created on first run) ──────────────────────────────────
DATA_DIR=./data
CHROMADB_PATH=./data/chromadb
SQLITE_PATH=./data/nexusai.db
