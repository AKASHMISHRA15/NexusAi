# ==========================================
# NexusAI / Vocalis - Root Git Ignore File
# ==========================================

# ── Secrets, Credentials & Environment Files ──
.env
.env.*
!.env.example
!.env.*.example
*firebase-adminsdk*.json
*-service-account*.json

# ── Python & Backend ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Local Databases, Embeddings & Uploads ──
*.db
*.sqlite
*.sqlite3
data/
backend/data/
backend/uploads/*
!backend/uploads/.gitkeep
notification_prefs.json
skills_state.json

# ── Node.js & Frontend ──
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
frontend/dist/
frontend/dist-ssr/

# ── Rust / Tauri ──
frontend/src-tauri/target/
**/target/
Cargo.lock

# ── Operating System & IDE Files ──
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ──
logs/
*.log
